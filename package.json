{
  "name": "compose-as-you-are",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "SPICAの学習経路に対応し、Pythonを書いて音とデータで確かめる教材",
  "scripts": {
    "serve": "python3 -m http.server 8000",
    "check": "node scripts/check.mjs",
    "test:js": "node --test tests/*.test.mjs",
    "test:python": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "test": "npm run check && npm run test:js && npm run test:python",
    "test:browser": "node scripts/browser-check.mjs",
    "package": "python3 scripts/package-release.py"
  },
  "engines": { "node": ">=20", "python": ">=3.10" },
  "license": "MIT"
}
